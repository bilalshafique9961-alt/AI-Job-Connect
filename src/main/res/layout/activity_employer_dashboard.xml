<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Welcome!"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:backgroundTint="#FF5722"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/userNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/roleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Role: Employer"
        android:textSize="16sp"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Active"
        android:textSize="14sp"
        android:layout_marginBottom="30dp" />

    <!-- Stats Row - Simple Layout without CardView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="30dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="#F0F0F0"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/totalJobsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#6200EE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Jobs"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="#F0F0F0"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/totalApplicantsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#6200EE" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Applicants"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="30dp" />

    <!-- Menu Buttons -->
    <Button
        android:id="@+id/postJobButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Post New Job"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#6200EE" />

    <Button
        android:id="@+id/myJobsButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="My Jobs"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50" />

    <Button
        android:id="@+id/applicantsButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="View Applicants"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#FF9800" />

    <Button
        android:id="@+id/shortlistedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Shortlisted"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#9C27B0" />

    <Button
        android:id="@+id/chatButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Messages"
        android:backgroundTint="#2196F3" />

</LinearLayout>